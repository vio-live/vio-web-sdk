# Vio Web SDK — environment variables
#
# Copy to `.env.local` (gitignored) and fill in your real values. The
# SDK consumer (e.g. the Allermedia editorial app) passes these to
# `Vio.init({ apiKey: ..., stripePublishableKey: ... })` at runtime. The
# SDK source NEVER reads env vars directly — they're only here for
# examples and dev.

# Your Vio API key for this client app (get one from the Vio dashboard).
VITE_VIO_API_KEY=your_api_key_here

# Vio backend endpoints — default is the shared dev environment.
#
# Mode A — direct (works if the backend's CORS allows your origin):
VITE_VIO_API_BASE=https://api-dev.vio.live
VITE_VIO_GRAPHQL_BASE=https://graph-ql-dev.vio.live
#
# Mode B — via the Vite dev proxy (CORS-bypass for local dev):
#   VITE_VIO_API_BASE=/proxy-vio
#   VITE_VIO_GRAPHQL_BASE=/proxy-graphql

# --- Payment vendor configuration ---

# Stripe publishable key (public-safe, bundle-OK).
# Used for: Apple Pay (via Payment Request) and Card flows.
# Test key from Stripe docs:
#   pk_test_TYooMQauvdEDq54NiTphI7jx
# Real Apple Pay on the Web also requires:
#   - Stripe account with Apple Pay enabled
#   - Domain registration via Stripe Dashboard (Settings → Payment methods → Apple Pay)
#   - Safari on macOS/iOS device with Apple Pay configured
VITE_VIO_STRIPE_PK=

# Optional: for testing the carousel auto-fetch mode without bootstrap,
# pass an explicit sponsor commerce apiKey via the demo HTML (or set a
# default here that examples/main.ts picks up).
VITE_VIO_DEMO_COMMERCE_KEY=
VITE_VIO_DEMO_PRODUCT_IDS=
